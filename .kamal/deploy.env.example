# Modelo dos segredos de deploy do Kamal.
#
# COMO USAR:
#   1. Copie este arquivo para .kamal/deploy.env
#   2. Preencha os valores reais (sem aspas mágicas; mantenha as aspas duplas)
#   3. Antes de rodar o Kamal, carregue no shell:  source .kamal/deploy.env
#   4. Rode:  bin/kamal setup   (primeira vez)  ou  bin/kamal deploy
#
# IMPORTANTE: .kamal/deploy.env está no .gitignore e NUNCA deve ser commitado.

# Token de acesso do Docker Hub (Account Settings -> Security -> New Access Token). Ver Parte 2.11.
export KAMAL_REGISTRY_PASSWORD="cole-aqui-o-token-do-docker-hub"

# Senha do banco PostgreSQL em container (VOCÊ escolhe; o container do banco é criado com ela).
export TCC_CESEP1_DATABASE_PASSWORD="escolha-uma-senha-forte-para-o-banco"

# Chaves do usuário IAM do app, com acesso só ao bucket S3 (Parte 2.4).
export AWS_ACCESS_KEY_ID="AKIA..."
export AWS_SECRET_ACCESS_KEY="cole-aqui-o-secret-access-key"

# Credenciais SMTP do Amazon SES (SMTP settings -> Create SMTP credentials, Parte 2.5).
export SMTP_USER_NAME="cole-aqui-o-usuario-smtp-do-ses"
export SMTP_PASSWORD="cole-aqui-a-senha-smtp-do-ses"
