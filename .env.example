POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=tcc_cesep1_development
DB_HOST=db

DATABASE_URL=postgres://postgres:postgres@db:5432/tcc_cesep1_development

FRONTEND_URL=http://localhost:3001

# Domínio-pai dos cookies de sessão. Deixe VAZIO em desenvolvimento (front e API
# são ambos "localhost"). Em produção, defina o domínio comum aos subdomínios do
# front e da API (ex.: cesepfaccat.com.br), senão o front não lê o XSRF-TOKEN.
COOKIE_DOMAIN=

# Host da aplicação (usado em links de email)
APP_HOST=localhost:3000

# Remetente dos emails do Devise
DEVISE_MAILER_SENDER=noreply@example.com
